{
  "name": "loanwick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/contracts packages/analysis packages/database-adapter",
    "typecheck": "npm run build && tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run build && vitest run",
    "evaluate": "npm run build && node scripts/evaluate.mjs",
    "fixtures:views": "npm run build && node scripts/export-demo-views.mjs",
    "dev:web": "npm run build && npm run dev --workspace @loanwick/web",
    "dev:web:live": "npm run build && npm run dev:live --workspace @loanwick/web",
    "build:web": "npm run build && npm run build --workspace @loanwick/web",
    "test:web": "npm run build && npm test --workspace @loanwick/web",
    "test:e2e": "npm run build && npm run test:e2e --workspace @loanwick/web",
    "test:e2e:database": "npm run test:e2e:database --workspace @loanwick/web",
    "check": "npm run typecheck && npm test && npm run evaluate && npm run fixtures:database:check && npm run typecheck --workspace @loanwick/web && npm run test:web",
    "test:database": "npm run build && node scripts/test-database.mjs",
    "fixtures:database": "node scripts/generate-database-seed.mjs",
    "fixtures:database:check": "node scripts/generate-database-seed.mjs --check",
    "test:database:local": "npm run build && node scripts/test-database-local.mjs",
    "join:cloud": "node scripts/join-cloud.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
