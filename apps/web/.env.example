# Public connection hints only. Never put user tokens or provider keys in VITE_*.
# Copy to apps/web/.env.live for `npm run dev:web:live`. Defaults to the team's shared Maincloud database (docs/CLOUD.md).
# For a disposable local server instead: VITE_SPACETIMEDB_URI=ws://127.0.0.1:4310 and that database's name.
VITE_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DATABASE=loanwick-hackutd26-dev
# Enable uploads only when Person 3 runs Person 2's HTTPS handler with this app's
# exact origin allowed and a browser-trusted TLS certificate.
VITE_UPLOAD_ORIGIN=
VITE_UPLOAD_WORKER_ID=
# Enable only after the worker can privately store and extract PDF/DOCX contracts.
# Uses supporting_document scope and the existing single-use upload protocol.
VITE_CONTRACT_UPLOAD_ENABLED=false
