{
  "name": "@loanwick/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:live": "vite --mode live --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "build:live": "tsc --noEmit && vite build --mode live",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:database": "node scripts/test-database.mjs",
    "test:e2e:service": "playwright test --config playwright.service.config.ts"
  },
  "dependencies": {
    "@loanwick/analysis": "*",
    "@loanwick/contracts": "*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "spacetimedb": "2.14.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "vite": "8.3.6"
  }
}
